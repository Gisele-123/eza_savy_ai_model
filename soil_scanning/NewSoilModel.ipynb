    "import json\n",
    "from pathlib import Path\n",
    "import pandas as pd\n",
    "\n",
    "def load_weather_forecast():\n",
    "    weather_path = Path('../weather/weather_prediction/shared_weather_data.json')\n",
    "    \n",
    "    try:\n",
    "        with open(weather_path, 'r') as f:\n",
    "            data = json.load(f)\n",
    "        \n",
    "        if not all(k in data.get('current_forecast', {}) for k in ['temperature', 'rainfall', 'date']):\n",
    "            raise ValueError(\"Weather data missing required keys in current_forecast\")\n",
    "            \n",
    "        forecast = data['current_forecast']\n",
    "        \n",
    "        if not isinstance(forecast['temperature'], (int, float)) or not isinstance(forecast['rainfall'], (int, float)):\n",
    "            raise ValueError(\"Temperature and rainfall must be numeric\")\n",
    "            \n",
    "        return forecast\n",
    "    \n",
    "    except Exception as e:\n",
    "        print(f\"⚠️ Weather loading error: {str(e)}\")\n",
    "        return {\n",
    "            'temperature': 25,\n",
    "            'rainfall': 0,\n",
    "            'date': 'Default'\n",
    "        }\n",
    "\n",
    "def predict_plant(R, G, B, pH=6.5, temp=25, rainfall=150, light_hours=12, top_n=3, weather_forecast=None):\n",
    "    if weather_forecast:\n",
    "        try:\n",
    "            temp = float(weather_forecast['temperature'])\n",
    "            rainfall = float(weather_forecast['rainfall'])\n",
    "            forecast_source = f\" (from {weather_forecast.get('date', 'forecast')})\"\n",
    "            weather_source = \"forecast\"\n",
    "        except (KeyError, ValueError) as e:\n",
    "            print(f\"⚠️ Invalid forecast data: {str(e)}. Using defaults.\")\n",
    "            forecast_source = \"\"\n",
    "            weather_source = \"invalid_forecast\"\n",
    "    else:\n",
    "        forecast_source = \"\"\n",
    "        weather_source = \"default\"\n",
    "    \n",
    "    hue = np.arctan2(np.sqrt(3) * (G - B), 2*R - G - B)\n",
    "    sat = 1 - (3 * min(R,G,B)) / (R + G + B + 1e-6)\n",
    "    bright = (R + G + B) / 3\n",
    "    \n",
    "    input_df = pd.DataFrame([[\n",
    "        R, G, B, hue, sat, bright, pH, temp, rainfall, light_hours\n",
    "    ]], columns=['R','G','B','Hue','Saturation','Brightness',\n",
    "                'pH','Temperature','Rainfall','Light_Hours'])\n",
    "    \n",
    "    env_features = ['pH','Temperature','Rainfall','Light_Hours']\n",
    "    input_df[env_features] = scaler.transform(input_df[env_features])\n",
    "    \n",
    "    probas = plant_model.predict_proba(input_df)[0]\n",
    "    top_idx = np.argsort(probas)[-top_n:][::-1]\n",
    "    percentages = (probas[top_idx] * 100).round(1)\n",
    "    plant_names = le_plant.inverse_transform(top_idx)\n",
    "    \n",
    "    output = {\n",
    "        \"metadata\": {\n",
    "            \"weather_used\": weather_source,\n",
    "            \"forecast_date\": weather_forecast.get('date') if weather_forecast else None\n",
    "        },\n",
    "        \"analysis\": {\n",
    "            \"soil_color\": [R, G, B],\n",
    "            \"pH\": pH,\n",
    "            \"temperature\": temp,\n",
    "            \"rainfall\": rainfall,\n",
    "            \"light_hours\": light_hours\n",
    "        },\n",
    "        \"recommendations\": [\n",
    "            {\n",
    "                \"rank\": i+1,\n",
    "                \"plant\": plant_names[i],\n",
    "                \"confidence\": float(percentages[i]),\n",
    "                \"suitability\": (\"Excellent\" if p > 80 else \n",
    "                               \"Good\" if p > 60 else \n",
    "                               \"Moderate\" if p > 40 else \n",
    "                               \"Marginal\")\n",
    "            } for i, p in enumerate(percentages)\n",
    "        ]\n",
    "    }\n",
    "    \n",
    "    print(\"\\n\" + \"=\"*50)\n",
    "    print(\"🌱 SOIL ANALYSIS REPORT\".center(50))\n",
    "    print(\"=\"*50)\n",
    "    print(f\"\\n🔍 Soil Properties (RGB): {R}, {G}, {B}\")\n",
    "    print(f\"🧪 pH: {pH:.1f}\")\n",
    "    print(f\"☀️ Light Exposure: {light_hours} hours/day\")\n",
    "    print(\"\\n🌦️ Environmental Conditions:\")\n",
    "    print(f\"   - Temperature: {temp:.1f}°C{forecast_source}\")\n",
    "    print(f\"   - Rainfall: {rainfall:.1f}mm{forecast_source}\")\n",
    "    print(f\"   - Weather Source: {weather_source.upper()}\")\n",
    "    print(\"\\n💡 Top Plant Recommendations:\")\n",
    "    for rec in output['recommendations']:\n",
    "        print(f\"   {rec['rank']}. {rec['plant']} ({rec['confidence']:.1f}%) - {rec['suitability']}\")\n",
    "    best = output['recommendations'][0]\n",
    "    print(\"\\n⭐ FINAL RECOMMENDATION ⭐\")\n",
    "    print(f\"{best['plant']} ({best['confidence']:.1f}% confidence)\")\n",
    "    print(\"=\"*50 + \"\\n\")\n",
    "    \n",
    "    return output\n",
    "\n",
    "weather_data = load_weather_forecast()\n",
    "print(f\"Loaded forecast for {weather_data['date']}:\")\n",
    "print(f\"- Temperature: {weather_data['temperature']}°C\")\n",
    "print(f\"- Rainfall: {weather_data['rainfall']}mm\")\n",
    "\n",
    "soil_params = {\n",
    "    'R': 170,\n",
    "    'G': 80,\n",
    "    'B': 30,\n",
    "    'pH': 6.8,\n",
    "    'light_hours': 10\n",
    "}\n",
    "\n",
    "try:\n",
    "    print(\"\\nRunning soil analysis...\")\n",
    "    results = predict_plant(\n",
    "        **soil_params,\n",
    "        weather_forecast=weather_data\n",
    "    )\n",
    "    \n",
    "    if results['metadata']['weather_used'] != 'forecast':\n",
    "        print(\"\\n⚠️ Warning: Default weather values were used\")\n",
    "    else:\n",
    "        print(\"\\n✅ Successfully used weather forecast data\")\n",
    "        \n",
    "except Exception as e:\n",
    "    print(f\"\\n❌ Analysis failed: {str(e)}\")\n",
    "    results = predict_plant(**soil_params)\n",
    "\n",
    "with open('soil_analysis_results.json', 'w') as f:\n",
    "    json.dump(results, f, indent=2)\n",
    "print(\"Results saved to soil_analysis_results.json\") "
